APP_HTTP_ADDR=:8080
APP_READ_TIMEOUT=15s
APP_WRITE_TIMEOUT=15s
APP_SHUTDOWN_TIMEOUT=10s
APP_LOG_LEVEL=info
APP_AUTO_MIGRATE=true

DATABASE_URL=postgresql://devmatch:devmatch@localhost:5432/devmatch?sslmode=disable
DATABASE_CONNECT_ATTEMPTS=20
DATABASE_CONNECT_DELAY=2s

POSTGRES_DB=devmatch
POSTGRES_USER=devmatch
POSTGRES_PASSWORD=devmatch

AUTH_ACCESS_SECRET=devmatch_access_secret_change_me
AUTH_REFRESH_SECRET=devmatch_refresh_secret_change_me
AUTH_ACCESS_TTL=15m
AUTH_REFRESH_TTL=720h
